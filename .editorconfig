# https://editorconfig.org — keeps whitespace consistent across the four
# languages in this tree without adding a formatter to the Nix closure.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.rs]
indent_size = 4

[*.nix]
indent_size = 2

[*.{js,ts,tsx,json,css,html,yml,yaml}]
indent_size = 2

[*.md]
# Markdown uses trailing double-space for hard line breaks.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
