#!/usr/bin/env bun
// pre-commit: CI's quick gates for the staged files, before the commit exists.
//
// The staged paths pick CI's lanes (.github/scripts/ci-changes.ts); a lane
// that is off runs nothing here either. What runs, and its name for
// LOSOS_HOOKS_SKIP:
//
//   rustfmt               cargo fmt --check, every crate      rust lane
//   clippy:<crate>        clippy --all-targets -D warnings,   rust lane
//                         each crate the change reaches
//   nix-lints             nixfmt, deadnix, statix over the    any .nix staged
//                         staged .nix files (nix/lint-nix.ts)
//   pins                  nix/check-pins.ts                   a lock or devenv.yaml
//   hashes                fix-hashes.py --check               a Cargo.lock or bun.lock
//   typecheck:<package>   bun run typecheck                   admin-ui/app, design-system/react
//   check-flake, eval-*   CI's eval job: every flake output   eval lane
//                         evaluated, the three systems'
//                         module merge, the ISO and edge
//                         image derivations
//
// The tests, the wasm32 lint, Playwright and the VM tests are pre-push's.
// The checks read the working tree, so unstaged edits count; pre-push runs
// on exactly the commits it sends.
import { existsSync } from "node:fs";
import * as path from "node:path";
import {
  hookCargo,
  hookCratesFor,
  hookEvalChecks,
  hookFinish,
  hookFmtAll,
  hookLanes,
  hookNixLints,
  hookRoot,
  hookStart,
  hookWasmPkgs,
  hookBun,
  laneOn,
  run,
  setHookTree,
} from "./lib.ts";

const git = (args: string[], allowFail = false): string => {
  const p = Bun.spawnSync(["git", ...args], { cwd: hookRoot() });
  if (p.exitCode !== 0 && !allowFail) process.exit(1);
  return p.stdout.toString().trim();
};
const gitQuiet = (args: string[]): boolean =>
  Bun.spawnSync(["git", ...args], { cwd: hookRoot() }).exitCode === 0;

process.chdir(hookRoot());

const staged = git(["diff", "--cached", "--name-only", "--diff-filter=ACMRD"]);
if (!staged) process.exit(0);

hookStart("pre-commit");
if (gitQuiet(["diff", "--quiet"])) {
  // The working tree is the index: what passes here is what is committed.
  setHookTree(git(["write-tree"]));
} else {
  console.log("  note: unstaged edits in the working tree are checked too");
}
await hookLanes(staged);

if (laneOn("rust")) {
  await run("rustfmt", hookFmtAll);
  for (const c of hookCratesFor(staged)) {
    await run(
      `clippy:${c}`,
      async (crate: string) =>
        hookCargo([
          "clippy",
          "--manifest-path",
          `${crate}/Cargo.toml`,
          "--all-targets",
          "--",
          "-D",
          "warnings",
        ]),
      c,
    );
  }
}

const nixfiles = git(["diff", "--cached", "--name-only", "--diff-filter=ACMR", "--", "*.nix"])
  .split("\n")
  .filter(Boolean);
await hookNixLints(nixfiles);

const stagedLines = staged.split("\n");
if (stagedLines.some((l) => /^(flake\.lock|devenv\.yaml|devenv\.lock)$/.test(l))) {
  await run("pins", () => hookBun(["nix/check-pins.ts"]));
}

if (stagedLines.some((l) => /(^|\/)(Cargo\.lock|bun\.lock)$/.test(l))) {
  await run("hashes", [
    "python3",
    ".github/scripts/fix-hashes.py",
    "--check",
    "--base",
    "HEAD",
  ]);
}

const cwd = process.cwd();
for (const pkg of ["admin-ui/app", "admin-ui/design-system/react"]) {
  if (!stagedLines.some((l) => l.startsWith(`${pkg}/`))) continue;
  const typecheck = async (p: string): Promise<number> => {
    process.chdir(path.join(hookRoot(), p));
    if (p === "admin-ui/app" && (await hookWasmPkgs()) !== 0) return 1;
    if (!existsSync("node_modules") && (await hookBun(["install", "--frozen-lockfile", "--ignore-scripts"])) !== 0)
      return 1;
    return hookBun(["run", "typecheck"]);
  };
  await run(`typecheck:${pkg}`, typecheck, pkg);
  process.chdir(cwd);
}

if (laneOn("eval")) {
  await hookEvalChecks();
}

hookFinish();
