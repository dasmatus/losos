#!/usr/bin/env bun
// commit-msg: no attribution trailers and no session links in a commit
// message. The history-scrub workflow rewrites what gets through
// (.github/scripts/scrub-message.py); this stops it before it is pushed.
import { existsSync, readFileSync, statSync } from "node:fs";

const msg = process.argv[2] ?? "";
if (msg && existsSync(msg) && statSync(msg).isFile()) {
  const bad = readFileSync(msg, "utf8")
    .split("\n")
    .filter((l) => !l.startsWith("#"))
    .filter((l) => /^(co-authored-by|generated[- ]with):|claude\.ai\/code\/session_/i.test(l));
  if (bad.length > 0) {
    console.error("commit-msg: the message carries an attribution trailer or a session link; drop it");
    for (const line of bad) console.error(`  ${line}`);
    process.exit(1);
  }
}
