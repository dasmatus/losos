{
  "name": "handbook",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "bunx --bun docusaurus",
    "start": "bunx --bun docusaurus start",
    "build": "bunx --bun docusaurus build",
    "swizzle": "bunx --bun docusaurus swizzle",
    "deploy": "bunx --bun docusaurus deploy",
    "clear": "bunx --bun docusaurus clear",
    "serve": "bunx --bun docusaurus serve",
    "write-translations": "bunx --bun docusaurus write-translations",
    "write-heading-ids": "bunx --bun docusaurus write-heading-ids",
    "typecheck": "bun --bun tsc",
    "check:links": "bun scripts/check-links.mjs",
    "theme": "scripts/derisk-theme.sh",
    "check": "bun run check:links && bun run check:braces",
    "check:braces": "bun scripts/check-braces.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.3",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/bun": "1.4.2",
    "@types/react": "^19.0.0",
    "braces": "file:./vendor/braces",
    "typescript": "~6.0.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "overrides": {
    "tinypool": "^2.2.0",
    "serialize-javascript": "^7.0.5",
    "uuid": "^11.1.1",
    "postcss-selector-parser": "^7.1.6",
    "braces": "file:./vendor/braces"
  },
  "packageManager": "bun@1.4.2"
}
