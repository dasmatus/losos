{
  "name": "losos-ds",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./tokens.css": "./dist/tokens.css",
    "./losos.css": "./dist/losos.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "esbuild tests/render.test.tsx --bundle --format=esm --platform=node --jsx=automatic --external:react-dom --outfile=dist/.render-test.mjs && node dist/.render-test.mjs",
    "build": "esbuild src/index.ts --bundle --format=esm --jsx=automatic --external:react --external:react-dom --outfile=dist/index.js && tsc --emitDeclarationOnly && cp ../tokens.css ../losos.css dist/"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "esbuild": "^0.25.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
