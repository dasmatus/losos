{
  "name": "losos-admin-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "EUPL-1.2",
  "description": "LosOS appliance admin UI. Built to static files and served by the front Nginx vhost.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lab:core": "node scripts/lab-core.mjs core",
    "lab:virt": "node scripts/lab-core.mjs virt",
    "lab:render": "node scripts/lab-core.mjs render",
    "test:browser": "node tests/wizard.browser.mjs && node tests/app.browser.mjs && node tests/toasts.browser.mjs && node tests/look.browser.mjs && node tests/advanced.browser.mjs && node tests/lab.browser.mjs && node tests/apps.browser.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.1",
    "@lezer/highlight": "1.2.4",
    "@radix-ui/react-toast": "^1.2.24",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.2.0",
    "react-aria-components": "1.21.1",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.16",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "playwright": "1.63.0",
    "tailwindcss": "^4.1.16",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
