/* EAS's build profiles, for the [development-builds][1] flow this README
 * documents: the launcher the development profile builds is what expo-dev-client
 * opens the dev server through on a phone or a simulator, alongside the
 * local prebuild path (npx expo run:android / run:ios). The file is the
 * only credentials-sensitive one in this tree, and it carries none: tokens
 * stay out (EXPO_TOKEN in CI keeps the secrets backend's, an `eas login`
 * stays on the developer), and an `android` credential makes EAS generate
 * one keystore in its own backend under the project, while `eas.json`s
 * credentials.json is the one expformat that never lands here.
 *
 * The development profile builds the dev client with Expo services, which
 * is the docs' `buildenv=build-with-expo-services` route:
 *
 *   eas build --platform android --profile development
 *
 * then `npx expo start` points the installed launcher at this checkout.
 * Its `ios` stanza rides the simulator: a real device build needs a paid
 * Apple Developer account for its signing identity, which nobody on this
 * account wants to carry in-tree or through the defaults — a separate
 * `development-device` profile with an ad-hoc distribution (provisioning)
 * is the TODO when that account exists; the docs' [local][2] route
 * (npx expo run:ios) is what fills the same slot until then and needs no
 * EAS side of it.
 *
 * The schema is [eas.json][3]'s; profile names, not build the profile's
 * development profiles only. `bun run build:web` and the other web lane
 * invite the web profiles of Expo Application Services never.
 *
 * [1] https://docs.expo.dev/develop/development-builds/introduction/?buildenv=build-with-expo-services
 * [2] https://docs.expo.dev/develop/development-builds/local-installation/
 * [3] https://docs.expo.dev/build-reference/eas-json/
 */
{
  "cli": {
    /* The account picks the project (owner lives in app.config.ts), and the
     * EAS link the CI's non-interactive job reads is app.config.ts's
     * extra.eas.projectId; the token never lands in-tree (see the comment
     * above). appVersionSource remote is what CI-versioned projects carry:
     * EAS's own tracking bumps and stamps, not the tree's. */
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    /* The dev client for the local machine's start (`expo start --dev-client`),
     * Android on EAS's workers: a debug APK installs as its own launcher app on
     * a phone with the docs' own flow (Expo services, no Android SDK needed on
     * the building machine). */
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        /* The simulator needs no Apple signing: EAS builds the app for the
         * machine's CPU and drops a .tar.gz of the .app; `npx expo start`
         * then serves it its JS. */
        "simulator": true
      },
      "channel": "development"
      /* TODO(profile development-device): the same profile for a real
       * iPhone — ad-hoc distribution with the tested devices' identities
       * registered in EAS, which needs a paid Apple Developer account no
       * one here has; run:ios is the local path until then. Leave the
       * simulator profile above untouched when it lands next to it. */
    },
    /* The App-Store-shaped preview the box's release flow runs later;
     * EAS does the prebuild, Expo's package publish scripts stay in-tree. */
    "preview": {
      "distribution": "store"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    }
  }
}
