{
  "//": "One tsconfig for both targets: the SPA's strict DOM tree and the mobile shell's react-native one. extends = expo/tsconfig.base (what Metro's typing, allowJs for the plugins, jsx: react-jsx pinned to the SPA's) expects; overrides below keep the options the SPA typechecked under before Expo arrived.",
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "jsx": "react-jsx",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],

    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,

    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,

    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "expo-env.d.ts"]
}
