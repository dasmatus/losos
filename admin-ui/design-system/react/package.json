{
  "name": "losos-ds",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./losos.css": "./dist/losos.css",
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "typecheck": "bun --bun tsc -p tsconfig.test.json",
    "test": "bun tests/render.test.tsx",
    "test:browser": "bun tests/browser.test.mjs",
    "build": "bun build src/index.ts --format=esm --external react --external react-dom --outfile=dist/index.js && bun --bun tsc --emitDeclarationOnly && cp ../tokens.css ../losos.css dist/ && cat ../tokens.css ../losos.css > dist/styles.css"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.2"
}
