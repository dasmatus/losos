{
  "name": "losos-tui",
  "version": "0.1.0",
  "private": true,
  "description": "losos: manage LosOS boxes and edges from a terminal, without SSH.",
  "type": "module",
  "bin": {
    "losos": "dist/losos.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "gen": "node scripts/gen.mjs",
    "build": "npm run gen && node scripts/build.mjs",
    "build:binary": "npm run build && node scripts/build-binary.mjs",
    "typecheck": "npm run gen && tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --import tsx --test --test-concurrency=1 test/*.test.ts test/*.test.tsx",
    "screenshots": "npm run gen && node --import tsx scripts/screenshots.tsx",
    "verify:binary": "node --import tsx scripts/verify-binary.ts"
  },
  "dependencies": {
    "ink": "8.0.0",
    "openpgp": "6.3.2",
    "react": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "esbuild": "0.28.2",
    "ink-testing-library": "4.0.0",
    "playwright-core": "1.63.0",
    "pngjs": "7.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
