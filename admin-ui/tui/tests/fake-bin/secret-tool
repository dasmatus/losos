#!/bin/sh
# A stand-in for libsecret's secret-tool, for the test suite: the same
# arguments, the same output shape (attributes on stderr, as libsecret
# prints them), the same exit statuses. Items live under the directory
# FAKE_SECRET_STORE, one numbered directory each. FAKE_SECRET_DOWN=1 answers
# like a session with no Secret Service. Every call is appended to
# FAKE_SECRET_LOG.
[ -n "$FAKE_SECRET_LOG" ] && printf '%s\n' "$*" >>"$FAKE_SECRET_LOG"
if [ "$FAKE_SECRET_DOWN" = 1 ] || [ -z "$FAKE_SECRET_STORE" ]; then
  echo "secret-tool: The name org.freedesktop.secrets was not provided by any .service files" >&2
  exit 1
fi
mkdir -p "$FAKE_SECRET_STORE"
verb=$1
shift
label=
all=0
want=$(mktemp)
trap 'rm -f "$want"' EXIT
while [ $# -gt 0 ]; do
  case $1 in
    --label=*) label=${1#--label=}; shift ;;
    --all) all=1; shift ;;
    --*) shift ;;
    *)
      if [ $# -lt 2 ]; then echo "usage: secret-tool ..." >&2; exit 2; fi
      printf '%s=%s\n' "$1" "$2" >>"$want"
      shift 2 ;;
  esac
done

items() { ls "$FAKE_SECRET_STORE" | sort -n; }
matches() {
  while IFS= read -r pair; do
    grep -Fxq -- "$pair" "$FAKE_SECRET_STORE/$1/attrs" || return 1
  done <"$want"
}

case $verb in
  store)
    for n in $(items); do
      cmp -s "$FAKE_SECRET_STORE/$n/attrs" "$want" && rm -rf "${FAKE_SECRET_STORE:?}/$n"
    done
    last=$(items | tail -n 1)
    n=$((${last:-0} + 1))
    mkdir "$FAKE_SECRET_STORE/$n"
    cp "$want" "$FAKE_SECRET_STORE/$n/attrs"
    printf '%s' "$label" >"$FAKE_SECRET_STORE/$n/label"
    cat >"$FAKE_SECRET_STORE/$n/secret"
    exit 0 ;;
  lookup)
    for n in $(items); do
      if matches "$n"; then cat "$FAKE_SECRET_STORE/$n/secret"; exit 0; fi
    done
    exit 1 ;;
  search)
    found=0
    for n in $(items); do
      matches "$n" || continue
      found=$((found + 1))
      printf '[/org/freedesktop/secrets/collection/login/%s]\n' "$n"
      printf 'label = %s\n' "$(cat "$FAKE_SECRET_STORE/$n/label")"
      printf 'secret = %s\n' "$(cat "$FAKE_SECRET_STORE/$n/secret")"
      printf 'created = 2026-10-14 09:00:00\nmodified = 2026-10-14 09:00:00\n'
      echo "schema = org.freedesktop.Secret.Generic" >&2
      sed 's/^\([^=]*\)=/attribute.\1 = /' "$FAKE_SECRET_STORE/$n/attrs" >&2
      [ "$all" = 1 ] || break
    done
    [ "$found" -gt 0 ] || exit 1
    exit 0 ;;
  clear)
    for n in $(items); do
      matches "$n" && rm -rf "${FAKE_SECRET_STORE:?}/$n"
    done
    exit 0 ;;
esac
echo "secret-tool: unknown command $verb" >&2
exit 2
