#!/bin/sh
# A stand-in for the AI tools that take the companion through a command of
# their own: claude, copilot, codex, gemini and qwen, by the name it is run
# as. Each call is appended to FAKE_AGENT_LOG as "<name> <args> @ <cwd>",
# and the tool keeps the record the real one keeps, in the same file and
# shape, so `losos agents` reads it back as it would the real one's.
name=$(basename "$0")
[ -n "$FAKE_AGENT_LOG" ] && printf '%s %s @ %s\n' "$name" "$*" "$PWD" >>"$FAKE_AGENT_LOG"
[ "$FAKE_AGENT_FAIL" = "$name" ] && { echo "$name: something broke" >&2; exit 3; }
case $name in
  claude) settings=$HOME/.claude/settings.json ;;
  copilot) settings=$HOME/.copilot/settings.json ;;
esac
case "$name $1 $2" in
  "claude plugin install" | "copilot plugin install")
    mkdir -p "$(dirname "$settings")"
    printf '{\n  "enabledPlugins": {\n    "%s": true\n  }\n}\n' "$3" >"$settings" ;;
  "claude plugin uninstall" | "copilot plugin uninstall")
    [ -f "$settings" ] && printf '{\n  "enabledPlugins": {}\n}\n' >"$settings" ;;
  "codex plugin add")
    mkdir -p "$HOME/.codex"
    printf '[plugins."%s"]\nenabled = true\n' "$3" >"$HOME/.codex/config.toml" ;;
  "codex plugin remove")
    : >"$HOME/.codex/config.toml" ;;
  "gemini extensions install" | "qwen extensions install")
    for last; do :; done
    mkdir -p "$HOME/.$name/extensions"
    rm -rf "$HOME/.$name/extensions/losos"
    cp -r "$last" "$HOME/.$name/extensions/losos" ;;
  "gemini extensions uninstall" | "qwen extensions uninstall")
    [ -d "$HOME/.$name/extensions/$3" ] || { echo "Extension \"$3\" not found." >&2; exit 1; }
    rm -rf "$HOME/.$name/extensions/$3" ;;
esac
exit 0
