#!/usr/bin/env node
// A stand-in for libsecret's secret-tool, for the test suite: the same
// arguments, the same output shape (attributes on stderr, as libsecret
// prints them), the same exit statuses. Items live in the JSON file named by
// FAKE_SECRET_STORE. FAKE_SECRET_DOWN=1 answers like a session with no
// Secret Service. Every call is appended to FAKE_SECRET_LOG.
import fs from "node:fs";

const store = process.env.FAKE_SECRET_STORE;
if (process.env.FAKE_SECRET_LOG) fs.appendFileSync(process.env.FAKE_SECRET_LOG, JSON.stringify(process.argv.slice(2)) + "\n");
if (process.env.FAKE_SECRET_DOWN === "1" || !store) {
  process.stderr.write("secret-tool: The name org.freedesktop.secrets was not provided by any .service files\n");
  process.exit(1);
}
const items = fs.existsSync(store) ? JSON.parse(fs.readFileSync(store, "utf8")) : [];
const save = () => fs.writeFileSync(store, JSON.stringify(items, null, 1));
const [verb, ...rest] = process.argv.slice(2);
let label = "";
const flags = new Set();
const args = [];
for (const a of rest) {
  if (a.startsWith("--label=")) label = a.slice(8);
  else if (a.startsWith("--")) flags.add(a);
  else args.push(a);
}
if (args.length % 2 !== 0) {
  process.stderr.write("usage: secret-tool ...\n");
  process.exit(2);
}
const attrs = {};
for (let i = 0; i < args.length; i += 2) attrs[args[i]] = args[i + 1];
const matches = (item) => Object.entries(attrs).every(([k, v]) => item.attributes[k] === v);

if (verb === "store") {
  const secret = fs.readFileSync(0, "utf8");
  for (let i = items.length - 1; i >= 0; i--) if (JSON.stringify(items[i].attributes) === JSON.stringify(attrs)) items.splice(i, 1);
  items.push({ label, attributes: attrs, secret, n: Date.now() + Math.random() });
  save();
  process.exit(0);
}
if (verb === "lookup") {
  const found = items.find(matches);
  if (!found) process.exit(1);
  process.stdout.write(found.secret);
  process.exit(0);
}
if (verb === "search") {
  const found = items.filter(matches);
  const shown = flags.has("--all") ? found : found.slice(0, 1);
  if (shown.length === 0) process.exit(1);
  shown.forEach((item, i) => {
    process.stdout.write(`[/org/freedesktop/secrets/collection/login/${i + 1}]\n`);
    process.stdout.write(`label = ${item.label}\n`);
    process.stdout.write(`secret = ${item.secret}\n`);
    process.stdout.write(`created = 2026-10-14 09:00:00\nmodified = 2026-10-14 09:00:00\n`);
    process.stderr.write(`schema = org.freedesktop.Secret.Generic\n`);
    for (const [k, v] of Object.entries(item.attributes)) process.stderr.write(`attribute.${k} = ${v}\n`);
  });
  process.exit(0);
}
if (verb === "clear") {
  for (let i = items.length - 1; i >= 0; i--) if (matches(items[i])) items.splice(i, 1);
  save();
  process.exit(0);
}
process.stderr.write(`secret-tool: unknown command ${verb}\n`);
process.exit(2);
