{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "isolatedModules": true
  },
  "include": [
    "*.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "plugins/**/*.ts",
    "plugins/**/*.js",
    "scripts/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "scripts/gen-tokens.ts.parse-scratch"
  ]
}
