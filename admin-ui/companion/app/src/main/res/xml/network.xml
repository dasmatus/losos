<?xml version="1.0" encoding="utf-8"?>
<!-- The box's admin pages serve a self-signed certificate on the LAN, so
     the companion trusts user-added CAs (adb install) and, below 28, plain
     https to <name>.local. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
