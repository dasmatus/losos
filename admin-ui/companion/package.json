{
  "name": "losos-companion",
  "version": "0.1.0",
  "private": true,
  "description": "LosOS Companion - the box in a phone's pocket, as an Expo (React Native) app.",
  "main": "expo-router/entry",
  "scripts": {
    "tokens": "bun scripts/gen-tokens.ts",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "build": "expo export --platform android"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "expo": "~54.0.0",
    "expo-build-properties": "~0.14.0",
    "expo-constants": "~18.0.0",
    "expo-linking": "~8.0.0",
    "expo-router": "~6.0.0",
    "expo-splash-screen": "~31.0.0",
    "expo-status-bar": "~3.0.0",
    "react": "19.1.0",
    "react-native": "~0.81.0",
    "react-native-blob-util": "^1.0.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-zeroconf": "^0.17.7"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.0"
  }
}
