{
  "redirects": [
    {
      "source": "/",
      "destination": "/diagrams/",
      "type": 302
    },
    {
      "source": "/lab/**",
      "destination": "/diagrams/",
      "type": 301
    }
  ],
  "rewrites": [
    {
      "source": "/diagrams/**",
      "destination": "/diagrams/index.html"
    }
  ],
  "headers": [
    {
      "source": "**/*",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        }
      ]
    }
  ]
}
