{
  "redirects": [
    {
      "source": "/",
      "destination": "/lab/",
      "type": 302
    }
  ],
  "rewrites": [
    {
      "source": "/lab/**",
      "destination": "/lab/index.html"
    }
  ],
  "headers": [
    {
      "source": "**/*",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        }
      ]
    }
  ]
}
