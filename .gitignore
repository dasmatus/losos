# Nix build output symlinks. `nix build` emits `result` for a single
# output, and `result-1`, `result-2`, ... when a build has multiple
# outputs (e.g. `nix build .#losos-ctl .#losos-admin-ui`) — match all of
# them, not just the bare `result` (a stray tracked `result-1` has bitten
# us before).
result
result-*

# (backend/ is Rust now; **/target below covers its build dir)
**/target

.superpowers/

# admin-ui/design-system/react/ is a dev-machine-only Bun package (TypeScript,
# see admin-ui/design-system/react/package.json) — never part of the Nix
# closure, but its local install and build/test output still need to stay
# untracked. `bun run build` and `bun run test` both write into dist/.
admin-ui/design-system/react/node_modules
admin-ui/design-system/react/dist

# design-sync (claude.ai/design importer): machine state, staged scripts,
# and regenerated build output. The durable set under .design-sync/
# (config.json, NOTES.md, conventions.md, previews/, overrides/) IS committed.
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# direnv + devenv machine state. devenv.nix IS committed (it is the dev
# environment definition); everything it generates at runtime is not.
.direnv/
.devenv/
.devenv.flake.nix
# .claude/ holds other sessions' worktrees and local state; only the three
# project files in it are tracked. settings.json installs the git hooks
# (nix/hooks) when a session starts.
.claude/*
!.claude/CLAUDE.md
!.claude/settings.json
!.claude/settings.local.json
# What devenv's git-hooks used to generate, before the hooks moved to
# nix/hooks. Derived state; devenv.lock IS committed.
/.pre-commit-config.yaml

# The two-VM LAN demo keeps its disks and sockets here (nix/demo/edge-lan/run.sh).
nix/demo/edge-lan/state/
# Pictures, logs and the driver link of nix/demo/record.sh.
nix/demo/recording/
# The light box, edge, box demo's pictures and driver (nix/demo/box-edge-box/record.sh).
nix/demo/box-edge-box/recording/

# quickemu's VM directory for docs/vm/losos.conf: the installer ISO, the disk,
# the firmware variables and the TPM state.
docs/vm/losos/
__pycache__/
