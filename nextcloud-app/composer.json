{
	"name": "losos/nextcloud-app",
	"description": "losos — admin settings app to toggle Local only vs On the mesh and trigger a NixOS rebuild.",
	"type": "nextcloud-app",
	"license": "AGPL-3.0-or-later",
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"phpunit/phpunit": "^10.0",
		"friendsofphp/php-cs-fixer": "^3.0"
	},
	"autoload": {
		"psr-4": {
			"OCA\\Losos\\": "lib/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"OCA\\Losos\\Tests\\": "tests/",
			"OCP\\": "tests/stubs/ocp/"
		}
	},
	"scripts": {
		"test": "phpunit",
		"lint": "php-cs-fixer fix --dry-run --diff",
		"cs-fix": "php-cs-fixer fix",
		"check": [
			"@lint",
			"@test"
		]
	},
	"config": {
		"allow-plugins": {
			"phpunit/phpunit": true
		}
	}
}