<?xml version="1.0"?>
<!--
  losos — appliance-config admin app with its own dedicated settings page.

  The app renders a macOS-System-Settings-style page (templates/main.php) where
  the admin edits losos.* knobs (hostname, Nextcloud/Forgejo mode, sharing,
  HTTPS, GPU, AIO ports). On "Apply" the page JS generates the overrides.nix
  body and POSTs it to /apply, which pipes it to the Haskell `losos-ctl apply`
  backend (via a locked-down sudoers rule). The backend validates, atomically
  rewrites modules/overrides.nix, and spawns nixos-rebuild; progress is polled
  from /status.

  <types><site_admin/> restricts the app's routes to admins at the AppFramework
  layer (a security property). The top-nav entry is registered dynamically in
  Application::boot() only for admins, so non-admins neither see nor reach it.
-->
<info>
	<id>losos</id>
	<name>losos</name>
	<summary>Configure this box: hostname, Nextcloud/Forgejo mode, storage, GPU</summary>
	<description><![CDATA[A dedicated settings page for this losos appliance. Edit the hostname, Nextcloud and Forgejo deployment mode, storage sharing, HTTPS, GPU acceleration, and AIO ports. Applying changes rewrites the NixOS config and triggers an automatic rebuild; progress is shown on the page.]]></description>
	<version>0.2.0</version>
	<licence>agpl</licence>
	<author>matus</author>
	<namespace>Losos</namespace>
	<category>integration</category>
	<dependencies>
		<nextcloud min-version="29" max-version="34"/>
	</dependencies>
	<!-- Admin-only: AppFramework rejects non-admin route access server-side.
	     The top-nav entry is added dynamically in Application::boot() for admins
	     only, so we intentionally do NOT declare a static <navigations> block. -->
	<types>
		<site_admin/>
	</types>
</info>