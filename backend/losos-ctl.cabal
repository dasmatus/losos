cabal-version:      3.0
name:              losos-ctl
version:           0.1.0
synopsis:          losos appliance control backend — toggle Local/Mesh and trigger NixOS rebuilds
description:
  losos-ctl is the privileged backend the losos Nextcloud app talks to (via a
  locked-down sudoers rule). It reads/writes the appliance's sharing mode
  (Local only vs On the mesh), rewrites the losos.sharingMyStorage line in the
  persisted flake, kicks off a detached nixos-rebuild, and records rebuild
  progress in a state file the PHP app polls.
  .
  Subcommands: state, change, status, rebuild-done (internal).
license:           AGPL-3.0-or-later
build-type:        Simple

common warnings
    ghc-options:      -Wall -Wcompat -Widentities
    default-language: Haskell2010

library
    import:           warnings
    hs-source-dirs:   src
    exposed-modules:  Lib
                    , Installer
    build-depends:
        base            >=4.17 && <5,
        aeson           >=2.0,
        optparse-applicative,
        directory,
        filepath,
        process,
        text,
        bytestring,
        unix,
        time,
        mtl
    default-language: Haskell2010

executable losos-ctl
    import:           warnings
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:
        base            >=4.17 && <5,
        losos-ctl,
        aeson,
        optparse-applicative,
        text,
        bytestring
    default-language: Haskell2010

test-suite spec
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test
    build-depends:
        base            >=4.17 && <5,
        losos-ctl,
        tasty,
        tasty-hunit,
        text,
        bytestring,
        aeson
    default-language: Haskell2010