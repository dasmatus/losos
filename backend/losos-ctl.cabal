cabal-version:      3.0
name:              losos-ctl
version:           0.1.0
synopsis:          losos appliance control — lososd daemon + losos-ctl facade
description:
  The losos control plane, split in two:
  .
  * lososd — a root systemd service owning the privileged operations: it
    reads/writes the appliance's sharing mode (Local vs mesh), rewrites the
    losos.* lines in the persisted flake, runs supervised nixos-rebuild
    transient units, and serves its state over the system D-Bus
    (org.losos1 / org.losos.Control1) plus a Bearer-authed loopback JSON API
    for the admin UI.
  .
  * losos-ctl — the facade: same subcommands as before (state, change,
    status, settings, apply, factory-reset), relayed over D-Bus; plus the
    local `install` subcommand (the installer ISO's auto-installer).

license:           AGPL-3.0-or-later
build-type:        Simple

common warnings
    ghc-options:      -Wall -Wcompat -Widentities
    default-language: Haskell2010

library
    import:           warnings
    hs-source-dirs:   src
    exposed-modules:  Lib
                    , Installer
                    , Daemon
                    , Facade
    build-depends:
        base            >=4.17 && <5,
        aeson           >=2.0,
        optparse-applicative,
        directory,
        filepath,
        process,
        text,
        bytestring,
        unix,
        time,
        mtl,
        dbus            >=1.4 && <2
    default-language: Haskell2010

executable losos-ctl
    import:           warnings
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:
        base            >=4.17 && <5,
        losos-ctl,
        aeson,
        optparse-applicative,
        text,
        bytestring,
        dbus            >=1.4 && <2
    default-language: Haskell2010

executable lososd
    import:           warnings
    main-is:          DaemonMain.hs
    hs-source-dirs:   app
    build-depends:
        base            >=4.17 && <5,
        losos-ctl
    default-language: Haskell2010

test-suite spec
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test
    build-depends:
        base            >=4.17 && <5,
        losos-ctl,
        tasty,
        tasty-hunit,
        text,
        bytestring,
        aeson
    default-language: Haskell2010
