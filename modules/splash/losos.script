# The LosOS boot screen: the logo, and under it a panel with the box's status.
#
# modules/splash.nix puts the palette (ground, ink, muted, accent, warn; each
# with .r .g .b) and `name` ("LosOS <tag>") above this file.
#
# While the box boots the logo plays its opening: an outline closes in from
# the edges of the screen onto a rule under the name, the salmon swims in
# from the left, level, and turns up into the logo's angle as it lands, and
# "LosOS" rises beside it. The rule then fills with its hatch as the boot
# goes on, and the caption ("LosOS <tag> is starting") sits under it. Once
# the box is up, modules/console.nix sends the rows tty1 shows without a
# splash, as
#
#   plymouth update --status='losos:#LosOS <tag> is ready||~On any computer...'
#
# (a text longer than one Plymouth message comes first in `losos+:` parts),
# one row per `|`, each led by a style character:
#
#   #  headline        @  address        !  warning headline
#   ~  secondary text  (space)  plain    >  the step running now, which pulses
#   +  parts of LosOS that run           *  a part starting, which pulses
#   -  a part that is not running
#   an empty row is a gap
#
# Then the logo glides to the top, slow at first, faster, slow again, while
# the rule fills to the end, the caption fades and the panel opens from its
# middle with the rows fading in. A disk that asks for a password opens the
# same panel for the prompt.
#
# On the installer medium the installer sends its own rows the same way:
# the firmware menu, its steps, and how it ended (install_screen.rs).
#
# `losos-mode:reboot` and `losos-mode:shutdown` (modules/splash.nix, at
# shutdown) play the glide backwards to a centred logo captioned "is
# restarting" or "is shutting down", and later updates are ignored. A
# splash started for anything but a boot shows the logo at rest, without
# the opening.

Window.SetBackgroundTopColor(ground.r, ground.g, ground.b);
Window.SetBackgroundBottomColor(ground.r, ground.g, ground.b);

screen.x = Window.GetX();
screen.y = Window.GetY();
screen.w = Window.GetWidth();
screen.h = Window.GetHeight();

# Type follows the screen height, so the panel takes the same share of a
# 768-line monitor and of a television.
size = Math.Int(Math.Max(screen.h / 54, 11));
pad = size;

# Seconds the logo takes to travel, at Plymouth's 50 frames a second.
duration = 1.2;
step = 1 / (50 * duration);

fun font (weight, scale)
{
  return "DejaVu Sans " + weight + Math.Int(size * scale);
}

fun centred (width)
{
  return Math.Int(screen.x + (screen.w - width) / 2);
}

# 0 before `from`, 1 after `to`, a straight line between (frames).
fun ramp (frame, from, to)
{
  return Math.Clamp((frame - from) / (to - from), 0, 1);
}

# Starts and ends at rest.
fun smooth (x)
{
  return (1 - Math.Cos(Math.Pi * x)) / 2;
}

# Fast, then settling into place.
fun out (x)
{
  return 1 - (1 - x) * (1 - x) * (1 - x);
}

# Out, past the mark by a few percent, and back: a landing.
fun land (x)
{
  return 1 + 2.4 * (x - 1) * (x - 1) * (x - 1) + 1.4 * (x - 1) * (x - 1);
}

# ── The logo: the salmon, the name and the rule ─────────────────────────────

# The name's size follows the screen; the fish and the rule follow the
# name, in the proportions of the logo beside the wordmark. Plymouth sizes
# text in points, so the name's measures come from its picture.
hero = Math.Int(Math.Max(screen.h * 0.075, 30));

word.image = Image.Text("LosOS", ink.r, ink.g, ink.b, 1, "DejaVu Sans Bold " + hero);
word.sprite = Sprite(word.image);
word.w = word.image.GetWidth();
# DejaVu's line is 1.164 of its size: the baseline 0.928 down from the top,
# the capitals 0.729 tall.
word.px = word.image.GetHeight() / 1.164;
word.baseline = word.px * 0.928;
word.caps = word.px * 0.729;

# The fish level, head right, and the same fish on a square it can turn
# inside: Plymouth keeps a turned image at its size and cuts what spills.
fish.original = Image("fish.png");
fish.w = Math.Int(word.w * 0.8);
fish.h = Math.Int(fish.original.GetHeight() * fish.w / fish.original.GetWidth());
fish.image = fish.original.Scale(fish.w, fish.h);
square.original = Image("fish-square.png");
square.side = Math.Int(square.original.GetWidth() * fish.w / fish.original.GetWidth());
square.image = square.original.Scale(square.side, square.side);
square.sprite = Sprite();
square.angle = -35 * Math.Pi / 180;
square.drawn = 1;

# While it swims the fish is cut in upright strips, each lifted by a wave
# that runs from the tail to the head.
strips = 16;
strip.w = Math.Int(fish.w / strips);
for (i = 0; i < strips; i++)
  {
    local.w = strip.w;
    if (i == strips - 1)
      w = fish.w - i * strip.w;
    strip.sprite[i] = Sprite(fish.image.Crop(i * strip.w, 0, w, fish.h));
  }

# The turned fish's box.
fish.bw = Math.Int(fish.w * Math.Cos(square.angle) - fish.h * Math.Sin(square.angle));
fish.bh = Math.Int(-fish.w * Math.Sin(square.angle) + fish.h * Math.Cos(square.angle));

# Side by side and centred: the fish, a gap, the name. The fish is centred
# on the middle of the capitals; the rule sits under the name, below the
# baseline.
gap = Math.Int(word.px * 0.24);
logo.w = fish.bw + gap + word.w;
logo.x = centred(logo.w);
fish.cx = logo.x + fish.bw / 2;
word.x = logo.x + fish.bw + gap;
local.caps = word.baseline - word.caps / 2;
word.dy = Math.Int(Math.Max(0, fish.bh / 2 - caps));
fish.dy = word.dy + caps;

rule.x = word.x + Math.Int(word.px * 0.04);
rule.w = word.w - Math.Int(word.px * 0.08);
rule.h = Math.Max(4, Math.Int(word.px * 0.07));
rule.dy = Math.Int(word.dy + word.baseline + word.px * 0.18);
rule.line = Sprite(Image("line.png").Scale(rule.w + 2, rule.h + 2));
rule.sunk = Sprite(Image("sunk.png").Scale(rule.w, rule.h));
rule.hatch = Image("hatch.png").Tile(rule.w, rule.h);
rule.sprite = Sprite();
rule.drawn = 0;
rule.fill = 0;

logo.h = Math.Int(Math.Max(fish.dy + fish.bh / 2, rule.dy + rule.h));
# In the middle of the screen, with the caption under it counted in.
logo.middle = Math.Int(screen.y + (screen.h - logo.h - 4 * size) / 2);
logo.top = logo.middle;

caption.sprite = Sprite();

fun set_caption (text)
{
  local.image = Image.Text(text, muted.r, muted.g, muted.b, 1, font("", 1.2));
  caption.sprite.SetImage(image);
  caption.x = centred(image.GetWidth());
  # Below the logo, and moving with it.
  caption.dy = logo.h + 2 * pad;
  message.dy = caption.dy + image.GetHeight() + pad;
}

# ── The opening ────────────────────────────────────────────────────────────

# Frames since the splash started; the opening is over at `opening`.
opening = 120;
intro = 0;

# Three outlines close in from the edges of the screen onto the rule, a
# few frames apart, and fade as they arrive.
echo.image = Image("muted.png");
echo.thick = Math.Max(1, Math.Int(size / 9));
for (i = 0; i < 3; i++)
  for (local.k = 0; k < 4; k++)
    echo.sprite[i * 4 + k] = Sprite();

fun draw_echoes (logo_y)
{
  for (local.i = 0; i < 3; i++)
    {
      local.e = smooth(ramp(intro, 4 * i, 4 * i + 32));
      local.o = 1;
      if (i > 0)
        o = 0.6 - 0.15 * i;
      o = o * ramp(intro, 4 * i, 4 * i + 4) * (1 - ramp(intro, 4 * i + 28, 4 * i + 36));
      local.x = Math.Int(screen.x + (rule.x - 1 - screen.x) * e);
      local.y = Math.Int(screen.y + (logo_y + rule.dy - 1 - screen.y) * e);
      local.w = Math.Max(1, Math.Int(screen.w + (rule.w + 2 - screen.w) * e));
      local.h = Math.Max(1, Math.Int(screen.h + (rule.h + 2 - screen.h) * e));
      local.t = echo.thick;
      for (local.k = 0; k < 4; k++)
        echo.sprite[i * 4 + k].SetOpacity(o);
      if (o > 0)
        {
          echo.sprite[i * 4].SetImage(echo.image.Scale(w, t));
          echo.sprite[i * 4].SetPosition(x, y, 6);
          echo.sprite[i * 4 + 1].SetImage(echo.image.Scale(w, t));
          echo.sprite[i * 4 + 1].SetPosition(x, y + h - t, 6);
          echo.sprite[i * 4 + 2].SetImage(echo.image.Scale(t, h));
          echo.sprite[i * 4 + 2].SetPosition(x, y, 6);
          echo.sprite[i * 4 + 3].SetImage(echo.image.Scale(t, h));
          echo.sprite[i * 4 + 3].SetPosition(x + w - t, y, 6);
        }
    }
}

# The salmon: in from the left edge, level, its tail beating less as it
# slows, then a turn up into the logo's angle that lands a touch past it.
fun draw_fish (logo_y)
{
  local.u = out(ramp(intro, 26, 84));
  local.cx = Math.Int(screen.x - fish.w + (fish.cx - screen.x + fish.w) * u);
  local.cy = Math.Int(logo_y + fish.dy + (1 - u) * (0.35 * fish.bh + 0.08 * fish.h * Math.Sin(intro / 5)));
  local.turning = intro >= 82;

  local.amp = 0.11 * fish.h * (1 - smooth(ramp(intro, 56, 80)));
  for (local.i = 0; i < strips; i++)
    {
      if (turning || intro < 26)
        strip.sprite[i].SetOpacity(0);
      else
        {
          local.along = i / (strips - 1);
          local.lift = amp * (1 - along) * (1 - along) * Math.Sin(2 * Math.Pi * 1.1 * along - intro * 0.5);
          strip.sprite[i].SetPosition(cx - fish.w / 2 + i * strip.w, Math.Int(cy - fish.h / 2 + lift), 5);
          strip.sprite[i].SetOpacity(1);
        }
    }

  if (turning)
    {
      local.turn = land(ramp(intro, 82, 108));
      if (turn != square.drawn)
        {
          square.sprite.SetImage(square.image.Rotate(square.angle * turn));
          global.square.drawn = turn;
        }
      square.sprite.SetPosition(cx - square.side / 2, cy - square.side / 2, 5);
      square.sprite.SetOpacity(1);
    }
  else
    square.sprite.SetOpacity(0);
}

# The rule's hatch is cropped to how far it has filled: the boot's progress,
# and all of it once the panel opens. It follows that value a little behind,
# so it sweeps rather than jumps.
progress = 0;

fun rule_want (e)
{
  if (intro < 34)
    return 0;
  return Math.Max(progress, e);
}

fun draw_rule (logo_y, e)
{
  local.y = logo_y + rule.dy;
  local.shown = ramp(intro, 26, 34);
  local.want = rule_want(e);
  global.rule.fill = rule.fill + (want - rule.fill) * 0.12;
  if (Math.Abs(want - rule.fill) < 0.002)
    global.rule.fill = want;

  local.w = Math.Int(rule.w * rule.fill);
  if (w != rule.drawn)
    {
      if (w > 0)
        rule.sprite.SetImage(rule.hatch.Crop(0, 0, w, rule.h));
      global.rule.drawn = w;
    }
  rule.line.SetPosition(rule.x - 1, y - 1, 2);
  rule.sunk.SetPosition(rule.x, y, 3);
  rule.sprite.SetPosition(rule.x, y, 4);
  rule.line.SetOpacity(shown);
  rule.sunk.SetOpacity(shown);
  if (w > 0)
    rule.sprite.SetOpacity(shown);
  else
    rule.sprite.SetOpacity(0);
}

# The whole logo with its top at logo_y; e is the glide's eased value.
fun draw_logo (logo_y, e)
{
  if (intro < opening)
    draw_echoes(logo_y);
  draw_fish(logo_y);
  draw_rule(logo_y, e);

  # The name rises into place as the fish arrives.
  local.rise = out(ramp(intro, 70, 94));
  word.sprite.SetPosition(word.x, Math.Int(logo_y + word.dy + (1 - rise) * 0.3 * word.px), 5);
  word.sprite.SetOpacity(rise);
}

# ── The panel and its rows ──────────────────────────────────────────────────

panel.image = Image("panel.png");
panel.sprite = Sprite();
edge.image = Image("accent.png");
edge.sprite = Sprite();
edge.height = Math.Max(3, Math.Int(size / 5));
message.sprite = Sprite();
rows = 0;
panel.h = 0;
panel.middle = 0;

fun row_image (line)
{
  local.style = line.CharAt(0);
  local.text = line.SubString(1, line.Length());
  if (line.Length() < 2)
    return NULL;
  if (style == "#")
    return Image.Text(text, accent.r, accent.g, accent.b, 1, font("Bold ", 1.3));
  if (style == "@")
    return Image.Text(text, ink.r, ink.g, ink.b, 1, font("Bold ", 1.1));
  if (style == "!")
    return Image.Text(text, warn.r, warn.g, warn.b, 1, font("Bold ", 1));
  if (style == "~")
    return Image.Text(text, muted.r, muted.g, muted.b, 1, font("", 1));
  if (style == ">")
    return Image.Text("▸  " + text, accent.r, accent.g, accent.b, 1, font("Bold ", 1));
  if (style == "+")
    return Image.Text("✓  " + text, muted.r, muted.g, muted.b, 1, font("", 1));
  if (style == "*")
    return Image.Text("…  " + text, accent.r, accent.g, accent.b, 1, font("", 1));
  if (style == "-")
    return Image.Text("✕  " + text, warn.r, warn.g, warn.b, 1, font("Bold ", 1));
  return Image.Text(text, ink.r, ink.g, ink.b, 1, font("", 1));
}

# Splits `text` at each `|` into global.row[0 .. rows - 1].
fun set_rows (text)
{
  local.n = 0;
  local.start = 0;
  local.len = text.Length();
  for (local.i = 0; i <= len; i++)
    {
      if (i == len || text.CharAt(i) == "|")
        {
          global.row[n] = text.SubString(start, i);
          n++;
          start = i + 1;
        }
    }
  global.rows = n;
}

# Works out where everything ends up with the logo at the top: the logo
# and the panel as one block, centred on the screen.
fun layout ()
{
  local.gap = Math.Int(size * 0.45);
  local.widest = 0;
  local.inner = 0;
  for (local.i = 0; i < rows; i++)
    {
      global.image[i] = row_image(row[i]);
      if (image[i])
        {
          widest = Math.Max(widest, image[i].GetWidth());
          inner += image[i].GetHeight() + gap;
        }
      else
        inner += size;
    }

  panel.w = Math.Int(Math.Min(screen.w - 2 * pad, Math.Max(widest + 6 * pad, screen.w * 0.42)));
  panel.h = Math.Int(inner + 3 * pad - gap);
  panel.x = centred(panel.w);
  # Near the top of the screen, unless the panel needs the room.
  logo.top = Math.Int(screen.y + Math.Max(pad, Math.Min(screen.h * 0.08, (screen.h - logo.h - 2 * pad - panel.h) / 2)));
  panel.y = logo.top + logo.h + 2 * pad;
  panel.middle = panel.y + panel.h / 2;

  local.y = Math.Int(panel.y + 1.5 * pad);
  global.pulsing = 0;
  for (i = 0; i < rows; i++)
    {
      global.pulse[i] = row[i].CharAt(0) == ">" || row[i].CharAt(0) == "*";
      if (pulse[i])
        global.pulsing = 1;
      if (!global.row_sprite[i])
        global.row_sprite[i] = Sprite();
      if (image[i])
        {
          row_sprite[i].SetImage(image[i]);
          global.row_x[i] = centred(image[i].GetWidth());
          global.row_y[i] = y;
          y += image[i].GetHeight() + gap;
        }
      else
        y += size;
    }
  while (global.row_sprite[i])
    {
      row_sprite[i].SetOpacity(0);
      i++;
    }
  message.y = panel.y + panel.h + pad;
}

# ── Moving between the two ──────────────────────────────────────────────────

# t runs from 0 (logo in the middle, caption) to 1 (logo at the top, panel)
# and follows `target` a step per frame.
t = 0;
target = 0;

# Draws the frame for the current t. The eased value starts slowly, speeds
# up and slows down again into place.
fun draw ()
{
  local.e = (1 - Math.Cos(Math.Pi * t)) / 2;

  local.logo_y = Math.Int(logo.middle + (logo.top - logo.middle) * e);
  draw_logo(logo_y, e);

  # The caption arrives after the opening, rides up with the logo and is
  # gone before the rows arrive.
  local.fade = Math.Max(0, 1 - 3 * e) * ramp(intro, 92, 110);
  caption.sprite.SetPosition(caption.x, logo_y + caption.dy, 3);
  caption.sprite.SetOpacity(fade);

  # The panel hangs under the logo and opens from its middle.
  local.middle = logo_y + logo.h + 2 * pad + panel.h / 2;
  if (e > 0 && rows > 0)
    {
      local.h = Math.Max(1, Math.Int(panel.h * e));
      local.y = Math.Int(middle - h / 2);
      panel.sprite.SetImage(panel.image.Scale(panel.w, h));
      panel.sprite.SetPosition(panel.x, y, 1);
      panel.sprite.SetOpacity(1);
      edge.sprite.SetImage(edge.image.Scale(panel.w, Math.Min(h, edge.height)));
      edge.sprite.SetPosition(panel.x, y, 2);
      edge.sprite.SetOpacity(1);
    }
  else
    {
      panel.sprite.SetOpacity(0);
      edge.sprite.SetOpacity(0);
    }

  for (local.i = 0; i < rows; i++)
    {
      if (image[i] && e > 0)
        {
          row_sprite[i].SetPosition(row_x[i], Math.Int(middle + (row_y[i] - panel.middle) * e), 3);
          row_sprite[i].SetOpacity(e * e * e);
        }
      else
        row_sprite[i].SetOpacity(0);
    }

  message.sprite.SetPosition(centred(message.width), Math.Int(message.y * e + (logo_y + message.dy + pad) * (1 - e)), 3);
}

# The running step and the parts still starting breathe, so a long one
# does not look stuck.
pulsing = 0;
frame = 0;

fun refresh_callback ()
{
  if (intro < opening)
    global.intro = intro + 1;
  if (t == 1 && pulsing)
    {
      global.frame = (frame + 1) % 100;
      for (local.i = 0; i < rows; i++)
        if (pulse[i] && image[i])
          row_sprite[i].SetOpacity(0.65 + 0.35 * Math.Cos(2 * Math.Pi * frame / 100));
    }
  if (t < target)
    global.t = Math.Min(target, t + step);
  else if (t > target)
    global.t = Math.Max(target, t - step);
  else if (intro >= opening && rule.fill == rule_want(smooth(t)))
    return NULL;
  draw();
}

# Shows `text` as the panel's rows and sends the logo up.
fun open_panel (text)
{
  set_rows(text);
  layout();
  global.target = 1;
  draw();
}

# ── Plymouth's calls ────────────────────────────────────────────────────────

status = "";
pending = "";
starting = 0;
locked = 0;
prompting = 0;
message.width = 0;
message.y = 0;

mode = Plymouth.GetMode();
if (mode == "shutdown")
  set_caption(name + " is shutting down");
else if (mode == "reboot")
  set_caption(name + " is restarting");
else if (mode == "boot")
  {
    set_caption(name + " is starting");
    starting = 1;
  }
else
  set_caption(name + " is updating");
# Only a boot plays the opening.
if (mode != "boot")
  intro = opening;
draw();

fun progress_callback (duration, fraction)
{
  if (starting)
    global.progress = fraction;
}

fun status_callback (text)
{
  if (!locked && text.SubString(0, 11) == "losos-mode:")
    {
      global.locked = 1;
      global.starting = 0;
      if (text.SubString(11, text.Length()) == "reboot")
        set_caption(name + " is restarting");
      else
        set_caption(name + " is shutting down");
      global.target = 0;
    }
  else if (!locked && text.SubString(0, 7) == "losos+:")
    global.pending = pending + text.SubString(7, text.Length());
  else if (!locked && text.SubString(0, 6) == "losos:")
    {
      global.starting = 0;
      global.status = pending + text.SubString(6, text.Length());
      global.pending = "";
      if (!prompting)
        open_panel(status);
    }
}

# A disk that will not unlock by itself asks here. The prompt takes the
# panel until it is answered.
fun password_callback (prompt, bullets)
{
  local.dots = "";
  for (local.i = 0; i < bullets; i++)
    dots = dots + "*";
  if (!prompt)
    prompt = "Password";
  global.prompting = 1;
  open_panel("#" + prompt + "|@" + dots + "_");
}

fun question_callback (prompt, entry)
{
  global.prompting = 1;
  open_panel("#" + prompt + "|@" + entry + " ");
}

fun normal_callback ()
{
  if (prompting)
    {
      global.prompting = 0;
      if (status != "" && !locked)
        open_panel(status);
      else
        global.target = 0;
    }
}

fun message_callback (text)
{
  local.image = Image.Text(text, muted.r, muted.g, muted.b, 1, font("", 0.9));
  global.message.width = image.GetWidth();
  message.sprite.SetImage(image);
  message.sprite.SetOpacity(1);
  draw();
}

fun hide_message_callback (text)
{
  message.sprite.SetOpacity(0);
}

Plymouth.SetRefreshFunction(refresh_callback);
Plymouth.SetBootProgressFunction(progress_callback);
Plymouth.SetUpdateStatusFunction(status_callback);
Plymouth.SetDisplayPasswordFunction(password_callback);
Plymouth.SetDisplayQuestionFunction(question_callback);
Plymouth.SetDisplayNormalFunction(normal_callback);
Plymouth.SetDisplayMessageFunction(message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);
